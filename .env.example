# Yerel çalıştırma için bu dosyayı ".env" adıyla kopyala ve doldur.
# Vercel'de aynı değerler Project Settings → Environment Variables altında durur.

PORT=3000

# --- Giriş
APP_USER=
APP_PASSWORD=
# Oturum imzası için uzun rastgele bir metin
AUTH_SECRET=

# --- Veritabanı ve medya depolama (Supabase → Project Settings → API Keys)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- İçerik planlama (fikir + caption üretimi) — console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Görsel ve video üretimi — replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_VIDEO_MODEL=minimax/video-01
REPLICATE_VIDEO_IMAGE_KEY=first_frame_image

# --- Stok fotoğraf (en az birini doldurman yeterli)
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- Trend araştırması — trendsmcp.ai
TRENDS_MCP_KEY=
TRENDS_MCP_URL=https://api.trendsmcp.ai/mcp

# --- Canva aktarımı — canva.com/developers → Integrations
# Redirect URL: <uygulama adresi>/api/canva/callback  (Ayarlar sekmesinde tam adres yazar)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
